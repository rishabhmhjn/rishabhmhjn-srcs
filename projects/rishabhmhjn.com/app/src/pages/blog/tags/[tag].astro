---
import { getCollection } from 'astro:content';
import PostList from '../../../components/PostList.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { slugifyTag, sortPosts } from '../../../lib/posts';

export async function getStaticPaths() {
  const posts = sortPosts(await getCollection('posts'));
  const tags = new Map<string, string>();
  posts.forEach((post) =>
    post.data.tags.forEach((tag) => tags.set(slugifyTag(tag), tag)),
  );

  return [...tags].map(([slug, tag]) => ({
    params: { tag: slug },
    props: {
      tag,
      posts: posts.filter((post) =>
        post.data.tags.some((candidate) => slugifyTag(candidate) === slug),
      ),
    },
  }));
}

const { tag, posts } = Astro.props;
---

<BaseLayout title={tag} description={`Posts filed under ${tag}.`}>
  <header class="page-header compact-header">
    <a class="back-link" href="/blog/">← All writing</a>
    <p class="eyebrow">Topic</p>
    <h1>{tag}</h1>
    <p>{posts.length} {posts.length === 1 ? 'post' : 'posts'}</p>
  </header>
  <section class="archive">
    <PostList posts={posts} />
  </section>
</BaseLayout>
