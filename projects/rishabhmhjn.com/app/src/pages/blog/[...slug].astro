---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  excerpt,
  formatDate,
  postPath,
  readingTime,
  slugifyTag,
  sortPosts,
  type Post,
} from '../../lib/posts';

export async function getStaticPaths() {
  const posts = sortPosts(await getCollection('posts'));
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, posts },
  }));
}

interface Props {
  post: Post;
  posts: Post[];
}

const { post, posts } = Astro.props;
const { Content, headings } = await render(post);
const currentIndex = posts.findIndex((candidate) => candidate.id === post.id);
const related = posts
  .filter(
    (candidate) =>
      candidate.id !== post.id &&
      candidate.data.tags.some((tag) =>
        post.data.tags.map((value) => value.toLowerCase()).includes(tag.toLowerCase()),
      ),
  )
  .slice(0, 2);
const nextPost = posts[currentIndex + 1];
const recommendations = related.length > 0
  ? related
  : [nextPost].filter((candidate) => candidate !== undefined);
const showToc = headings.filter((heading) => heading.depth === 2).length >= 4;
---

<BaseLayout
  title={post.data.title}
  description={excerpt(post.data.description, 280)}
  type="article"
>
  <article class="post">
    <header class="post-header">
      <a class="back-link" href="/blog/">← All writing</a>
      <h1>{post.data.title}</h1>
      <p class="post-deck">{excerpt(post.data.description, 300)}</p>
      <div class="post-byline">
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        <span aria-hidden="true">·</span>
        <span>{readingTime(post.body ?? '')} min read</span>
      </div>
      {
        post.data.tags.length > 0 && (
          <ul class="tag-list" aria-label="Topics">
            {post.data.tags.map((tag) => (
              <li><a href={`/blog/tags/${slugifyTag(tag)}/`}>{tag}</a></li>
            ))}
          </ul>
        )
      }
    </header>

    {
      showToc && (
        <details class="table-of-contents">
          <summary>On this page</summary>
          <ol>
            {headings
              .filter((heading) => heading.depth === 2)
              .map((heading) => (
                <li><a href={`#${heading.slug}`}>{heading.text}</a></li>
              ))}
          </ol>
        </details>
      )
    }

    <div class="article-body">
      <Content />
    </div>
  </article>

  <aside class="continue-reading">
    <p class="section-label">Continue reading</p>
    <h2>More from the archive</h2>
    <div>
      {
        recommendations.map((recommendation) => (
          <a href={postPath(recommendation)}>
            <span>{formatDate(recommendation.data.date)}</span>
            <strong>{recommendation.data.title}</strong>
          </a>
        ))
      }
      <a href="/blog/">
        <span>Archive</span>
        <strong>Browse all writing →</strong>
      </a>
    </div>
  </aside>
</BaseLayout>
