---
import type { Post } from '../lib/posts';
import { excerpt, formatDate, postPath, readingTime } from '../lib/posts';

interface Props {
  posts: Post[];
  compact?: boolean;
}

const { posts, compact = false } = Astro.props;
---

<ol class:list={['post-list', { compact }]}>
  {
    posts.map((post) => (
      <li>
        <div class="post-meta">
          <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
          <span aria-hidden="true">·</span>
          <span>{readingTime(post.body ?? '')} min read</span>
        </div>
        <h3>
          <a href={postPath(post)}>{post.data.title}</a>
        </h3>
        {!compact && <p>{excerpt(post.data.description)}</p>}
      </li>
    ))
  }
</ol>
